<node id="Media Engine">
  <data key="d0">Media Engine</data>
  <data key="d1">artifact</data>
  <data key="d2">A component of the Apple M4 chip that provides hardware-accelerated support for H.264, HEVC, ProRes, ProRes RAW, AV1 decode, and video encode and decode functions.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
