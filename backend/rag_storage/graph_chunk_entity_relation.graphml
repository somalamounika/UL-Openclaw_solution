<node id="Force Touch Trackpad">
  <data key="d0">Force Touch Trackpad</data>
  <data key="d1">artifact</data>
  <data key="d2">A trackpad on the MacBook Air that enables precise cursor control, pressure sensing, Force clicks, accelerators, pressure-sensitive drawing, and Multi-Touch gestures.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
