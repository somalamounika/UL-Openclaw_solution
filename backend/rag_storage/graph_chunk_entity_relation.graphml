<graph edgedefault="undirected"><node id="MacBook Air (13-inch, M4, 2025)">
  <data key="d0">MacBook Air (13-inch, M4, 2025)</data>
  <data key="d1">artifact</data>
  <data key="d2">A MacBook Air model introduced in 2025 with a 13.6-inch display, Apple M4 chip, unified memory, SSD storage, battery, camera, audio, wireless connectivity, and macOS.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Apple M4 Chip">
  <data key="d0">Apple M4 Chip</data>
  <data key="d1">artifact</data>
  <data key="d2">Apple's M4 chip used in the MacBook Air, featuring a 10-core CPU, 8-core or 10-core GPU, hardware-accelerated ray tracing, a 16-core Neural Engine, and media engine capabilities.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Apple Intelligence">
  <data key="d0">Apple Intelligence</data>
  <data key="d1">concept</data>
  <data key="d2">Apple's personal intelligence system that helps users write, express themselves, and get things done while emphasizing privacy protections.&lt;SEP&gt;A feature described as available in beta, with some feature and language availability limits.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000&lt;SEP&gt;726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-001</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Liquid Retina Display">
  <data key="d0">Liquid Retina Display</data>
  <data key="d1">artifact</data>
  <data key="d2">The MacBook Air display, a 13.6-inch LED-backlit IPS display with 2560x1664 native resolution, 500 nits brightness, P3 wide color, True Tone, and support for 1 billion colors.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Unified Memory">
  <data key="d0">Unified Memory</data>
  <data key="d1">data</data>
  <data key="d2">The MacBook Air memory configuration, listed as 16GB by default and configurable to 24GB or 32GB.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="SSD Storage">
  <data key="d0">SSD Storage</data>
  <data key="d1">data</data>
  <data key="d2">The MacBook Air storage configuration, listed as 256GB SSD and configurable to 512GB, 1TB, or 2TB.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Lithium-Polymer Battery">
  <data key="d0">Lithium-Polymer Battery</data>
  <data key="d1">artifact</data>
  <data key="d2">A built-in 53.8-watt-hour lithium-polymer battery in the MacBook Air that supports up to 18 hours of video streaming and up to 15 hours of wireless web use.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="MacOS">
  <data key="d0">MacOS</data>
  <data key="d1">artifact</data>
  <data key="d2">The operating system used by the MacBook Air, described as the most advanced desktop operating system and integrated with Apple Intelligence, iPhone Mirroring, and window tiling.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="Wi-Fi 6E">
  <data key="d0">Wi-Fi 6E</data>
  <data key="d1">concept</data>
  <data key="d2">A wireless networking standard noted as available in supported countries and regions.&lt;SEP&gt;The MacBook Air wireless networking standard, based on 802.11ax.&lt;SEP&gt;The wireless networking capability integrated into the product.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000&lt;SEP&gt;726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-002&lt;SEP&gt;9e39f966-6a7f-4eaf-b4a1-91379f76dc4d:chunk_000001-chunk-000</data>
