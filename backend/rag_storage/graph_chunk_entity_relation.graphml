<node id="Backlit Magic Keyboard">
  <data key="d0">Backlit Magic Keyboard</data>
  <data key="d1">artifact</data>
  <data key="d2">A backlit keyboard on the MacBook Air with 78 or 79 keys, including 12 full-height function keys and 4 arrow keys in an inverted T arrangement, plus Touch ID and an ambient light sensor.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
