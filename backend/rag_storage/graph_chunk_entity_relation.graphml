  <data key="d4">MacBook Air- TS 2.pdf</data>
  <data key="d5">1790828627</data>
  <data key="d6"></data>
</node>
<node id="12MP Center Stage Camera">
  <data key="d0">12MP Center Stage Camera</data>
  <data key="d1">artifact</data>
  <data key="d2">A MacBook Air camera with Desk View support, 1080p HD video recording, and advanced image signal processing with computational video.</data>
  <data key="d3">726b0cc7-6290-41c6-aa12-e0d03faa2bfe:chunk_000001-chunk-000</data>
  <data key="d4">MacBook Air- TS 2.pdf</data>
