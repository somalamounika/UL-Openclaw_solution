# LLM (OpenAI-compatible)
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Or Azure OpenAI (preferred when set — overrides LLM_* above)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
# Optional faster model for standards/clauses/certs mapping (falls back to chat deployment)
# AZURE_OPENAI_MAPPING_DEPLOYMENT=gpt-4o-mini
# LLM_MAPPING_MODEL=gpt-4o-mini
# MAPPING_CONCURRENCY=4
# MAX_STANDARDS_PER_COMPONENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# LightRAG chunk index (embeddings + local stores). Relative paths are under backend/.
# LIGHTRAG_WORKING_DIR=rag_storage
# Optional separate embedding resource (defaults to AZURE_OPENAI_* above)
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_API_KEY=your_embedding_key
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-12-01-preview

# Azure AI Search (semantic chunk index) — optional
# If unset, chunks are stored in memory and retrieved with lexical ranking.
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your_search_admin_key
AZURE_SEARCH_INDEX_NAME=ul-chunks

# Neo4j (local single instance — use bolt://, not neo4j://)
NEO4J_URI=bolt://localhost:7687
# Set NEO4J_USE_ROUTING=true only for Neo4j Aura / clustered neo4j:// URLs
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# OpenClaw triage archives (Azure Blob Storage)
AZURE_BLOB_CONTAINER=openclaw-ul
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Server
CORS_ORIGINS=http://127.0.0.1:5174
LOG_LEVEL=info
